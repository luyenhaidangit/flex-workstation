                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Buy\",\n  \"price\": 20050,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            }
          ]
        },
        {
          "name": "04 - Trạng thái",
          "item": [
            {
              "name": "01. Xem order book",
              "request": {
                "method": "GET",
                "header": [],
