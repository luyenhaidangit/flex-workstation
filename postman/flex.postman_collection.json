{
  "info": {
    "_postman_id": "58c6e6c9-7aac-45a0-88e7-95a994fd06df",
    "name": "Flex - Local Services",
    "description": "Bộ Postman Collection dùng chung cho các service local trong Flex workstation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "exchangeBaseUrl",
      "value": "http://localhost:5266"
    },
    {
      "key": "exchangeBrokerId",
      "value": "DEMO-BUYER"
    },
    {
      "key": "exchangeBuyerBrokerId",
      "value": "DEMO-BUYER"
    },
    {
      "key": "exchangeSellerBrokerId",
      "value": "DEMO-SELLER"
    },
    {
      "key": "exchangeOrderId",
      "value": "1"
    },
    {
      "key": "exchangeBuyerOrderId",
      "value": "1"
    },
    {
      "key": "exchangeSellerOrderId",
      "value": "1"
    },
    {
      "key": "exchangeSymbol",
      "value": "FXS"
    },
    {
      "key": "exchangeCorrelationId",
      "value": "postman-mvp02-001"
    }
  ],
  "item": [
    {
      "name": "Flex Exchange Service",
      "description": "API khớp lệnh instrument mô phỏng trong-memory. Dữ liệu bị xóa khi khởi động lại service.",
      "item": [
        {
          "name": "01 - Khớp lệnh",
          "item": [
            {
              "name": "01. Đặt lệnh bán chờ",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Correlation-Id",
                    "value": "{{exchangeCorrelationId}}"
                  }
                ],
                "body": {
                  "mode": "raw",
              "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Sell\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Lệnh không có đối ứng, được giữ trong order book."
              },
              "response": []
            },
            {
              "name": "02. Đặt lệnh mua khớp toàn phần",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
              "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Chạy sau request 01 để tạo TradeExecuted với khối lượng 100."
              },
              "response": []
            },
            {
              "name": "03. Đặt lệnh bán để khớp một phần",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
              "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Sell\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            },
            {
              "name": "04. Đặt lệnh mua khớp một phần",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
              "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 200\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Chạy sau request 03. Lệnh mua còn dư 100 trong order book."
              },
              "response": []
            }
          ]
        },
        {
          "name": "02 - Hủy lệnh",
          "item": [
            {
              "name": "01. Đặt lệnh chờ để hủy",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const response = pm.response.json();",
                      "if (response.accepted && response.orderId) {",
                      "    pm.collectionVariables.set(\"exchangeOrderId\", response.orderId);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
              "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Sell\",\n  \"price\": 21000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Lưu orderId từ response vào collection variable để request hủy dùng tự động."
              },
              "response": []
            },
            {
              "name": "02. Hủy lệnh chờ",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "X-Correlation-Id",
                    "value": "{{exchangeCorrelationId}}"
                  }
                ],
                "url": "{{exchangeBaseUrl}}/api/orders/{{exchangeOrderId}}?brokerId={{exchangeBrokerId}}",
                "description": "Chạy sau request 01 trong cùng folder."
              },
              "response": []
            }
          ]
        },
        {
          "name": "03 - Validation",
          "item": [
            {
              "name": "01. BrokerId rỗng",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            },
            {
              "name": "02. Symbol không hỗ trợ",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"BAD\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            },
            {
              "name": "03. Giá không đúng bước giá",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Buy\",\n  \"price\": 20050,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            }
          ]
        },
        {
          "name": "04 - Trạng thái",
          "item": [
            {
              "name": "01. Xem order book",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/orderbook"
              },
              "response": []
            },
            {
              "name": "02. Xem event log",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/events"
              },
              "response": []
            }
          ]
        },
        {
          "name": "05 - MVP 02 Tra cứu",
          "description": "Tra cứu order status, trade tape và event history của MVP 02.",
          "item": [
            {
              "name": "01. Tra cứu trạng thái order",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/orders/{{exchangeOrderId}}?brokerId={{exchangeBrokerId}}"
              },
              "response": []
            },
            {
              "name": "02. Tra cứu event history của order",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/orders/{{exchangeOrderId}}/events?brokerId={{exchangeBrokerId}}"
              },
              "response": []
            },
            {
              "name": "03. Tra cứu trade tape",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/trades"
              },
              "response": []
            },
            {
              "name": "04. Tra cứu event journal",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/events"
              },
              "response": []
            }
          ]
        },
        {
          "name": "06 - MVP 03 Bảng điện demo",
          "description": "Smoke flow cho bảng điện FXS: đọc market snapshot, tạo hai lệnh đối ứng bằng hai broker demo và hủy lệnh còn chờ.",
          "item": [
            {
              "name": "01. Bảng điện - order book",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/orderbook",
                "description": "Nguồn dữ liệu bid/ask và khối lượng chờ của mã FXS."
              },
              "response": []
            },
            {
              "name": "02. Bảng điện - trade tape",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/trades",
                "description": "Nguồn dữ liệu giao dịch mới nhất để UI hiển thị trade tape."
              },
              "response": []
            },
            {
              "name": "03. Demo seller - đặt lệnh bán chờ",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const response = pm.response.json();",
                      "if (response.accepted && response.orderId) {",
                      "    pm.collectionVariables.set(\"exchangeSellerOrderId\", response.orderId);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Correlation-Id", "value": "{{exchangeCorrelationId}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeSellerBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Sell\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Chạy trước request 04 để tạo thanh khoản bán cho lệnh đối ứng."
              },
              "response": []
            },
            {
              "name": "04. Demo buyer - đặt lệnh mua khớp",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Correlation-Id", "value": "{{exchangeCorrelationId}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBuyerBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Chạy sau request 03. Sau khi khớp, kiểm tra lại order book và trade tape."
              },
              "response": []
            },
            {
              "name": "05. Demo buyer - đặt lệnh chờ để hủy",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const response = pm.response.json();",
                      "if (response.accepted && response.orderId) {",
                      "    pm.collectionVariables.set(\"exchangeBuyerOrderId\", response.orderId);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Correlation-Id", "value": "{{exchangeCorrelationId}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBuyerBrokerId}}\",\n  \"symbol\": \"{{exchangeSymbol}}\",\n  \"side\": \"Buy\",\n  \"price\": 19000,\n  \"quantity\": 100\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            },
            {
              "name": "06. Demo buyer - hủy lệnh chờ",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "X-Correlation-Id", "value": "{{exchangeCorrelationId}}" }
                ],
                "url": "{{exchangeBaseUrl}}/api/orders/{{exchangeBuyerOrderId}}?brokerId={{exchangeBuyerBrokerId}}",
                "description": "Chạy sau request 05 để kiểm tra vòng đời hủy lệnh demo."
              },
              "response": []
            }
          ]
        }
      ]
    }
  ]
}
