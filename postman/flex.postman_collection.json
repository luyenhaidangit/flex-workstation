    {
      "name": "02 - Hủy lệnh",
      "item": [
        {
          "name": "01. Đặt lệnh chờ để hủy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.accepted && response.orderId) {",
                  "    pm.collectionVariables.set(\"orderId\", response.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brokerId\": \"{{brokerId}}\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Sell\",\n  \"price\": 21000,\n  \"quantity\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/orders",
            "description": "Lưu orderId từ response vào collection variable để request hủy dùng tự động."
          },
          "response": []
        },
        {
          "name": "02. Hủy lệnh chờ",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}?brokerId={{brokerId}}",
            "description": "Chạy sau request 01 trong cùng folder."
          },
          "response": []
        }
      ]
    },
