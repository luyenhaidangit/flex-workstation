                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            },
            {
              "name": "02. Symbol không hỗ trợ",
              "request": {
                "method": "POST",
                "header": [
                  {
