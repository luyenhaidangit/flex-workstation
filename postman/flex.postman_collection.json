{
  "info": {
    "_postman_id": "58c6e6c9-7aac-45a0-88e7-95a994fd06df",
    "name": "Flex - Local Services",
    "description": "Bộ Postman Collection dùng chung cho các service local trong Flex workstation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "exchangeBaseUrl",
      "value": "http://localhost:5266"
    },
    {
      "key": "exchangeBrokerId",
      "value": "DemoBroker"
    },
    {
      "key": "exchangeOrderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Flex Exchange Service",
      "description": "API khớp lệnh FXS in-memory. Dữ liệu bị xóa khi khởi động lại service.",
      "item": [
        {
          "name": "01 - Khớp lệnh",
          "item": [
            {
              "name": "01. Đặt lệnh bán chờ",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Sell\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Lệnh không có đối ứng, được giữ trong order book."
              },
              "response": []
            },
            {
              "name": "02. Đặt lệnh mua khớp toàn phần",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Chạy sau request 01 để tạo TradeExecuted với khối lượng 100."
              },
              "response": []
            },
            {
              "name": "03. Đặt lệnh bán để khớp một phần",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Sell\",\n  \"price\": 20000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders"
              },
              "response": []
            },
            {
              "name": "04. Đặt lệnh mua khớp một phần",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Buy\",\n  \"price\": 20000,\n  \"quantity\": 200\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Chạy sau request 03. Lệnh mua còn dư 100 trong order book."
              },
              "response": []
            }
          ]
        },
        {
          "name": "02 - Hủy lệnh",
          "item": [
            {
              "name": "01. Đặt lệnh chờ để hủy",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const response = pm.response.json();",
                      "if (response.accepted && response.orderId) {",
                      "    pm.collectionVariables.set(\"exchangeOrderId\", response.orderId);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"brokerId\": \"{{exchangeBrokerId}}\",\n  \"symbol\": \"FXS\",\n  \"side\": \"Sell\",\n  \"price\": 21000,\n  \"quantity\": 100\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{exchangeBaseUrl}}/api/orders",
                "description": "Lưu orderId từ response vào collection variable để request hủy dùng tự động."
              },
              "response": []
            },
            {
              "name": "02. Hủy lệnh chờ",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{exchangeBaseUrl}}/api/orders/{{exchangeOrderId}}?brokerId={{exchangeBrokerId}}",
                "description": "Chạy sau request 01 trong cùng folder."
              },
              "response": []
            }
          ]
        },
        {
          "name": "03 - Validation",
          "item": [
            {
              "name": "01. BrokerId rỗng",
              "request": {
                "method": "POST",
                "header": [
