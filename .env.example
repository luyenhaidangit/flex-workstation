# Copy to .env (gitignored) and supply READ-ONLY PostgreSQL credentials for MCP database tools (.mcp.json).
# Never use a write/superuser role for AI MCP database connections.
FLEX_EXCHANGE_DB_URL=postgresql://<READONLY_USER>:<PASSWORD>@localhost:5432/flex_exchange
FLEX_BROKER_DB_URL=postgresql://<READONLY_USER>:<PASSWORD>@localhost:5432/flex_broker
FLEX_VSD_DB_URL=postgresql://<READONLY_USER>:<PASSWORD>@localhost:5432/flex_vsd
