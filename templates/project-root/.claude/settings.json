{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(claude --version)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-NonInteractive", "-File", ".claude\\scripts\\check-skill-path.ps1"],
            "statusMessage": "Kiem tra vi tri skill source..."
          }
        ]
      }
    ]
  }
}
