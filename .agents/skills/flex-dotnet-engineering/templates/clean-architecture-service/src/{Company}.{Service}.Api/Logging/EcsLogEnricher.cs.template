using System.Diagnostics;
using Serilog.Core;
using Serilog.Events;

namespace {Company}.{Service}.Api.Logging;

public sealed class EcsLogEnricher : ILogEventEnricher
{
    public void Enrich(LogEvent logEvent, ILogEventPropertyFactory propertyFactory)
    {
        logEvent.AddPropertyIfAbsent(propertyFactory.CreateProperty(
            LogFields.LogLevel, logEvent.Level.ToString().ToLowerInvariant()));

        if (Activity.Current is { } activity)
        {
            logEvent.AddPropertyIfAbsent(propertyFactory.CreateProperty(
                LogFields.TraceId, activity.TraceId.ToString()));
            logEvent.AddPropertyIfAbsent(propertyFactory.CreateProperty(
                LogFields.SpanId, activity.SpanId.ToString()));
        }

        if (logEvent.Exception is not { } exception)
        {
            return;
        }

        logEvent.AddPropertyIfAbsent(propertyFactory.CreateProperty(
            LogFields.ErrorType, exception.GetType().Name));
        logEvent.AddPropertyIfAbsent(propertyFactory.CreateProperty(
            LogFields.ErrorMessage, exception.Message));
        logEvent.AddPropertyIfAbsent(propertyFactory.CreateProperty(
            LogFields.ErrorStackTrace, exception.ToString()));
    }
}
