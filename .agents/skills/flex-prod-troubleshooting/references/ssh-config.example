# Copy into the WSL distro's ~/.ssh/config (NOT into the repo) and replace placeholders.
# Create a dedicated, least-privilege account on the server for the agent:
#   - no sudo; member of `docker` only if restart/logs through docker is required
#     (note: docker group is root-equivalent, prefer a restricted wrapper if possible)
#   - dedicated key: ssh-keygen -t ed25519 -f ~/.ssh/flex_prod_agent -C "agent-readonly"
#   - chmod 600 ~/.ssh/config ~/.ssh/flex_prod_agent

Host flex-prod-app
    HostName <server-ip-or-dns>
    User <readonly-user>
    IdentityFile ~/.ssh/flex_prod_agent
    IdentitiesOnly yes
    BatchMode yes
    ConnectTimeout 10
    ServerAliveInterval 30
    StrictHostKeyChecking yes

# Add one Host block per role, always named flex-prod-<role>:
# Host flex-prod-db
# Host flex-prod-gateway
